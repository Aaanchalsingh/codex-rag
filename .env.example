# ── LLM ──────────────────────────────────────────────────────────────────────
# Free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Codebase ──────────────────────────────────────────────────────────────────
# Local path (for local dev)
CODEBASE_PATH=./my-project

# GitHub repo to auto-clone and index on startup (for HF Spaces)
GITHUB_REPO_URL=https://github.com/user/repo

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./data/chroma_db

# Set to true to force in-memory ChromaDB (used automatically on HF Spaces)
CHROMA_IN_MEMORY=false

# ── Models ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq fallback chain (comma-separated, tried in order)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
